/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Security headers for EVERY response. A bare "/" only matches the root URL, so
# for a while they reached the home page and nothing else. Keep a single "/*"
# rule: if two rules match, Cloudflare joins repeated headers with a comma
# ("DENY, DENY" is invalid). DENY, not SAMEORIGIN: the site never frames its own
# pages (previews and playgrounds render inline).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
