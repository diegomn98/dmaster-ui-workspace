{
  "name": "ngx-dmaster",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "keyv": "^5.6.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve ngx-test-app",
    "build": "ng build dmaster-ui && npm run build:styles && npm run build:schematics",
    "build:styles": "sass projects/ngx-dmaster-ui/src/lib/styles/index.scss dist/dmaster-ui/styles/dmaster-ui.css --load-path=projects/ngx-dmaster-ui/src/lib/styles --style=compressed --no-source-map",
    "build:schematics": "tsc -p projects/ngx-dmaster-ui/tsconfig.schematics.json && node scripts/copy-schematics-assets.mjs",
    "build:app": "ng build ngx-test-app",
    "watch": "ng build dmaster-ui --watch --configuration development",
    "test": "ng test dmaster-ui --no-watch",
    "test:coverage": "ng test dmaster-ui --no-watch --code-coverage",
    "test:app": "ng test ngx-test-app --no-watch",
    "lint": "ng lint",
    "lint:styles": "stylelint \"projects/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "npm run build && npm run build:app && npm test && npm run test:app && npm run lint && npm run lint:styles && npm run format:check",
    "release:npm": "npm run release:check && cd dist/dmaster-ui && npm publish --access public",
    "push:lib": "git subtree push --prefix=projects/ngx-dmaster-ui lib-origin main",
    "push:workspace": "git push origin main"
  },
  "config": {
    "remotes": {
      "lib-origin": "https://github.com/diegomn98/dmaster-ui.git",
      "origin": "https://github.com/diegomn98/dmaster-ui-workspace.git"
    },
    "setup": "git remote add origin https://github.com/diegomn98/dmaster-ui-workspace.git && git remote add lib-origin https://github.com/diegomn98/dmaster-ui.git"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.32",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^20.3.32",
    "@angular-devkit/schematics": "^20.3.32",
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "ng-packagr": "^20.3.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.14",
    "sass": "^1.80.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.1.1"
  }
}
